{
  "name": "hostmattic-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-push.js && next build && node scripts/copy-standalone-assets.js",
    "start": "node server.js",
    "lint": "next lint",
    "admin:password": "node scripts/set-admin-password.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "test:pricing": "tsc lib/api/hostingPricing.ts lib/api/client.ts lib/crypto/secrets.ts --rootDir lib --outDir .test-build --module commonjs --target es2020 --moduleResolution node --skipLibCheck --esModuleInterop && node --test \"tests/*.test.js\"",
    "orders": "node scripts/orders.js",
    "orders:audit": "node scripts/orders.js",
    "test": "npm run test:pricing",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3"
  }
}