# PostgreSQL Database (Coolify internal or external connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostmattic?schema=public"

# Upstream Provisioning API Credentials (Optional: if unset, mock fallback handles all requests)
RESELLER_AUTH_USERID=""
RESELLER_API_KEY=""
RESELLER_API_BASE_URL="https://httpapi.com/api"

# Application Secrets
# REQUIRED: Generate a strong random secret. Example: openssl rand -base64 64
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Administrator Account
#
# The database is the only authority on credentials. Nothing here is consulted when
# anyone signs in - the stored password hash is checked, and that is all.
#
# ADMIN_EMAIL only decides which address the first administrator gets. It is not a
# secret and has no effect once that account exists.
#
# ADMIN_PASSWORD is OPTIONAL and is used in exactly one situation: seeding an
# administrator into a database that has none. The recommended path is to leave it
# empty and create the account out of band after the first deploy, so that no
# password is left sitting in the hosting provider's configuration:
#
#   npm run admin:password -- "<password>"
#
# Use the same command to change the password later. If no administrator exists and
# this is empty, the app logs that fact and creates nothing - there is no fallback
# password in the source.
ADMIN_EMAIL="admin@hostmattic.com"
ADMIN_PASSWORD=""

# Payment Gateways (Optional: if unset, sandbox simulation is used)
# Key-encryption-key for secrets stored in the database (payment gateway keys).
# Generate with: openssl rand -hex 32
# Without it, gateway secrets cannot be saved or read and payments are refused.
SETTINGS_ENCRYPTION_KEY=""

# The gateway variables below are a TRANSITIONAL fallback. Once the keys are
# entered in Admin -> Payment Gateways, remove them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
INSTAMOJO_API_KEY=""
INSTAMOJO_AUTH_TOKEN=""
INSTAMOJO_SANDBOX="true"

# Transactional Email via Resend API (Optional: if unset, emails run in simulation mode)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Hostmattic <notifications@hostmattic.com>"

# Signup Abuse Protection (Optional)
# Rate limiting (5 signups per IP per hour), the honeypot field and Gmail
# address canonicalisation are always on and need no configuration.
# Set these two to additionally require a Cloudflare Turnstile challenge.
# Leave empty and the challenge is skipped; the other controls still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Legacy SuperSite Forwarding (Optional)
# The old PHP storefront used to live on this domain. Its marketing URLs are
# redirected in legacy-redirects.mjs, but transactional callbacks
# (reseller.php?action=...&tid=...) can only be served by the upstream platform.
# Set this to forward them with their query string intact.
#
# IMPORTANT: next.config.mjs redirects() is evaluated at BUILD time, so this must
# be available to the build, not only at runtime. In Coolify add it as a build
# environment variable and redeploy.
#
# Leave empty and those URLs keep returning 404, which is safer than sending
# someone holding a one-time token to a marketing page.
LEGACY_SUPERSITE_ORIGIN=""

# Scheduler secret for POST /api/cron/reminders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the endpoint stays shut rather than open.
CRON_SECRET=""

# Where operational alerts go. Defaults to every ADMIN account in the database.
ADMIN_ALERT_EMAIL=""

# Alert when the upstream reseller balance falls below this (INR).
LOW_BALANCE_THRESHOLD_INR="5000"

# Signing secret for Resend delivery webhooks, from the Resend dashboard
# (Webhooks -> your endpoint -> Signing Secret). Starts with whsec_.
# Without it the webhook rejects everything rather than trusting unsigned
# payloads, which would let anyone mark a customer's address as bouncing.
RESEND_WEBHOOK_SECRET=""
