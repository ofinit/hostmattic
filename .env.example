# PostgreSQL Database (Coolify internal or external connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostmattic?schema=public"

# Upstream Provisioning API Credentials (Optional: if unset, mock fallback handles all requests)
RESELLER_AUTH_USERID=""
RESELLER_API_KEY=""
RESELLER_API_BASE_URL="https://httpapi.com/api"

# Application Secrets
# REQUIRED: Generate a strong random secret. Example: openssl rand -base64 64
JWT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateways (Optional: if unset, sandbox simulation is used)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
INSTAMOJO_API_KEY=""
INSTAMOJO_AUTH_TOKEN=""
INSTAMOJO_SANDBOX="true"

# Transactional Email via Resend API (Optional: if unset, emails run in simulation mode)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Hostmattic <notifications@hostmattic.com>"

